# ==========================================
# 1. THƯ MỤC DỮ LIỆU DỰ ÁN (Quan trọng nhất)
# ==========================================
# Chỉ bỏ qua NỘI DUNG (PDF, MD) bên trong các thư mục,
# nhưng vẫn giữ thư mục trên GitHub (nhờ file .gitkeep)
1_RawPDF/*
!1_RawPDF/.gitkeep

2_Quality_Checked/*
!2_Quality_Checked/.gitkeep

3_Result_MD/*
!3_Result_MD/.gitkeep

4_Summarized_files/*
!4_Summarized_files/.gitkeep

5_ArchivedFiles/*
!5_ArchivedFiles/.gitkeep

# ==========================================
# 2. MÔI TRƯỜNG ẢO PYTHON (Virtual Environments)
# ==========================================
.venv/
venv/
env/
ENV/
.env

# ==========================================
# 3. FILE RÁC & CACHE CỦA PYTHON
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# ==========================================
# 4. CẤU HÌNH CỦA TRÌNH BIÊN DỊCH / IDE
# ==========================================
# Ẩn các file cấu hình cá nhân nếu bạn dùng IntelliJ, VSCode, v.v.
.idea/
.vscode/
*.swp
*.swo

# ==========================================
# 5. FILE RÁC CỦA HỆ ĐIỀU HÀNH
# ==========================================
.DS_Store
Thumbs.db